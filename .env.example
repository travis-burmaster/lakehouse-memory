# Copy to .env (gitignored) and fill in values before running integration tests:
# `cp .env.example .env`
#
# See SETUP.md for how to obtain each value.

# Required: enable integration tests
LAKEHOUSE_MEMORY_INTEGRATION=1

# Required: Databricks workspace
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi-xxxxxxxxxxxxxxxxxxxxxxxx
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx

# Required: pre-existing Vector Search endpoint (shared infrastructure;
# tests do NOT create or destroy this — only indexes inside it).
DATABRICKS_VECTOR_SEARCH_ENDPOINT=your_vs_endpoint_name

# Required: a Unity Catalog catalog the test user can write to.
LAKEHOUSE_MEMORY_TEST_CATALOG=your_catalog

# Schema prefix; per-run a unique suffix is appended (e.g. lakehouse_memory_test_a1b2c3d4)
# and the whole schema is DROP-ed CASCADE at the end of the test session.
LAKEHOUSE_MEMORY_TEST_SCHEMA=lakehouse_memory_test
